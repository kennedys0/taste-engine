{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Taste Engine project style config",
  "type": "object",
  "required": [
    "schema_version",
    "scope",
    "primary_style",
    "user_confirmed"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "scope": {
      "const": "project"
    },
    "primary_style": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "secondary_style": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 80
    },
    "overrides": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "user_confirmed": {
      "const": true
    },
    "notes": {
      "type": "string"
    },
    "design_controls": {
      "type": "object",
      "properties": {
        "design_variance": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "motion_intensity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "visual_density": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        }
      },
      "additionalProperties": false,
      "description": "Optional user-approved project-specific control values, never a global preset."
    }
  },
  "additionalProperties": false
}
